{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VinUni-AI20k/Day26-Track-1-AI-Product-Handbook/blob/main/rubric/grader-output.schema.json",
  "title": "Day 26 Operating Dashboard grader output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "submission",
    "grader",
    "structural_gate",
    "item_results",
    "criterion_scores",
    "caps_applied",
    "overrides_applied",
    "source_checks",
    "total_score",
    "grade_band",
    "review"
  ],
  "properties": {
    "rubric_version": {
      "const": "2.0.0"
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "sha256", "anonymous_id"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "anonymous_id": {"type": "string", "minLength": 1}
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "version", "run_at", "run_id"],
      "properties": {
        "system_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "structural_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "errors": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "item_results": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {"$ref": "#/$defs/item_result"}
    },
    "criterion_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TD", "TQ", "DR", "GT", "HO"],
      "properties": {
        "TD": {"type": "number", "minimum": 0, "maximum": 20, "multipleOf": 0.5},
        "TQ": {"type": "number", "minimum": 0, "maximum": 30, "multipleOf": 0.5},
        "DR": {"type": "number", "minimum": 0, "maximum": 30, "multipleOf": 0.5},
        "GT": {"type": "number", "minimum": 0, "maximum": 15, "multipleOf": 0.5},
        "HO": {"type": "number", "minimum": 0, "maximum": 5, "multipleOf": 0.5}
      }
    },
    "caps_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cap_id", "criterion_id", "evidence", "score_before", "score_after"],
        "properties": {
          "cap_id": {"enum": ["CAP-TD-WRONG-MODEL", "CAP-TD-LAGGING-MAJORITY", "CAP-TQ-UNTRACEABLE"]},
          "criterion_id": {"enum": ["TD", "TQ"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "score_before": {"type": "number", "minimum": 0},
          "score_after": {"type": "number", "minimum": 0}
        }
      }
    },
    "overrides_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["override_id", "item_id", "evidence", "score_before", "score_after"],
        "properties": {
          "override_id": {"enum": ["OVR-DR-VAGUE-THEN", "OVR-DR-MISSING-FORBIDDEN", "OVR-GT30-REVENUE", "OVR-GT-VAGUE"]},
          "item_id": {"type": "string", "pattern": "^(DR-0[1-5]|GT-(30|60|90))$"},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "score_before": {"type": "number", "minimum": 0},
          "score_after": {"type": "number", "minimum": 0}
        }
      }
    },
    "source_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_check"}
    },
    "total_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 0.5
    },
    "grade_band": {
      "enum": ["OUTSTANDING", "STRONG", "PASS", "NEEDS_REWORK", "FAIL"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "triggers", "reviewer_note"],
      "properties": {
        "status": {"enum": ["AUTO_FINAL", "HUMAN_REQUIRED", "HUMAN_FINAL"]},
        "triggers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "reviewer_note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "row_id", "field", "quote"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "row_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "item_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "criterion_id",
        "verdict",
        "awarded_points",
        "max_points",
        "evidence",
        "reason",
        "confidence",
        "needs_human_review"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^(TD|TQ|DR|GT|HO)-[A-Z0-9-]+$"},
        "criterion_id": {"enum": ["TD", "TQ", "DR", "GT", "HO"]},
        "verdict": {"enum": ["MET", "NOT_MET", "UNCERTAIN"]},
        "awarded_points": {"type": "number", "minimum": 0, "multipleOf": 0.5},
        "max_points": {"type": "number", "exclusiveMinimum": 0},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needs_human_review": {"type": "boolean"}
      }
    },
    "source_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "source_type", "url", "status", "claim_supported", "checked_at", "note"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[LOG]-[0-9]{2}$"},
        "source_type": {"enum": ["BM", "MH", "TB"]},
        "url": {"type": ["string", "null"]},
        "status": {"enum": ["VERIFIED", "UNREACHABLE", "NOT_APPLICABLE", "CONTRADICTED"]},
        "claim_supported": {"type": ["boolean", "null"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    }
  }
}
